{
  "name": "@wx-vsce/root",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for VS Code extensions",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "watch": "pnpm -r --parallel run watch",
    "package": "pnpm --filter './extensions/**' run package",
    "test": "pnpm -r run test"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912"
}
