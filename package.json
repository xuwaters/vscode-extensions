{
  "name": "@wx-vsce/root",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for VS Code extensions",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "watch": "pnpm -r --parallel run watch",
    "package": "pnpm --filter './extensions/**' run package",
    "test": "pnpm -r run test",
    "bump": "deno --allow-read --allow-write scripts/bump-extension-versions.ts"
  },
  "devDependencies": {
    "@types/node": "^25.8.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
