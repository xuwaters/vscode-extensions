{
  "name": "@wx-vsce/root",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for VS Code extensions",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "watch": "pnpm -r --parallel run watch",
    "package": "pnpm --filter './extensions/**' run package",
    "test": "pnpm -r run test"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489"
}
