{
  // The webview is a browser bundle, not a Node one, and it is the only place
  // in this repo that uses decorators: `@microsoft/fast-element` ships the
  // *legacy* decorator signatures, which need `experimentalDecorators`, and its
  // `@observable` installs prototype accessors that a `[[Define]]`-semantics
  // class field would shadow — hence `useDefineForClassFields: false`.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/webview",
    "rootDir": "..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["."]
}
