{# This is a comment #}
# Generated for {{ app_name }} ({{ environment }})

APP_NAME={{ app_name }}
APP_ENV={{ environment | lower }}

{# Conditional entries #}
{% if debug %}
LOG_LEVEL=debug
RUST_BACKTRACE=1
{% else %}
LOG_LEVEL={{ log_level | lower }}
{% endif %}

{# Quoted values and shell expansion stay highlighted #}
DATABASE_URL="postgres://{{ db.user }}:{{ db.password }}@{{ db.host }}:{{ db.port }}/{{ db.name }}"
CACHE_DIR="${HOME}/.cache/{{ app_name }}"

{# Loop over template data #}
{% for secret in secrets %}
{{ secret.key }}='{{ secret.value }}'
{% endfor %}

{# Variable declarations #}
{% let workers = cpu_count * 2 %}
WORKER_COUNT={{ workers }}

{# export prefix #}
{% if use_export %}
export API_TOKEN={{ api_token }}
{% endif %}

{# Raw block - no template processing #}
{% raw %}
LITERAL={{ this_stays_literal }}
{% endraw %}
