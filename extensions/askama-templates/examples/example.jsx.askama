{# This is a comment #}
import React from 'react';
{% for dep in imports %}
import { {{ dep.name }} } from '{{ dep.path }}';
{% endfor %}

export function {{ component_name }}({ items, user }) {
  {# Variable declarations #}
  {% let title = format!("{} dashboard", app_name) %}
  const title = '{{ title }}';

  return (
    <div className="{{ root_class | lower }}">
      <h1>{title}</h1>

      {# Conditional rendering #}
      {% if show_greeting %}
      <p>Welcome, {user.name}!</p>
      {% elif visitor_count > 100 %}
      <p>Visitor #{{ visitor_count }}</p>
      {% else %}
      <p>Welcome, guest!</p>
      {% endif %}

      {# Loop over template data #}
      <ul>
        {% for item in items %}
        <li key="{{ loop.index }}">{{ item.label | capitalize }}</li>
        {% endfor %}
      </ul>

      {# JSX expressions and template expressions side by side #}
      <span>{items.length} of {{ total_count }}</span>

      {# Raw block - no template processing #}
      {% raw %}
      <span>{{ this_stays_literal }}</span>
      {% endraw %}

      {# Macro usage #}
      {% import "macros.jsx" as m %}
      {{ m.render_card(title="Hello", body="World") }}
    </div>
  );
}
