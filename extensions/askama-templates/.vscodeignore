src/
test/
webview/
examples/
**/*.test.ts

# Build configuration.
tsconfig.json
tsconfig.tsbuildinfo
tsdown.config.mts

# Build leftovers.
target/
temp
**/*.js.map
**/*.ts.map
**/*.d.ts

# Repo bookkeeping.
.gitignore
wasm/.gitignore
