{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Askama Injection",
  "scopeName": "askama.injection",
  "injectionSelector": "L:text.html.askama -comment.block.askama -meta.raw.block.askama -meta.statement.askama -meta.expression.askama, L:source.rust.askama -comment.block.askama -meta.raw.block.askama -meta.statement.askama -meta.expression.askama, L:source.js.askama -comment.block.askama -meta.raw.block.askama -meta.statement.askama -meta.expression.askama, L:source.ts.askama -comment.block.askama -meta.raw.block.askama -meta.statement.askama -meta.expression.askama",
  "patterns": [
    { "include": "source.askama#comment" },
    { "include": "source.askama#statement" },
    { "include": "source.askama#expression" }
  ]
}
