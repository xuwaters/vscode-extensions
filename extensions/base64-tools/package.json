{
  "name": "wx-vsce-base64-tools",
  "displayName": "Base64 Tools",
  "description": "Encode and decode Base64 of selected text in the VS Code editor",
  "version": "0.1.0",
  "private": true,
  "publisher": "weixu",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "base64-tools.encode",
        "title": "Encode Selection to Base64",
        "category": "Base64"
      },
      {
        "command": "base64-tools.decode",
        "title": "Decode Selection from Base64",
        "category": "Base64"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "base64-tools.encode",
          "when": "editorHasSelection",
          "group": "1_modification"
        },
        {
          "command": "base64-tools.decode",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "base64-tools.encode",
        "key": "ctrl+e ctrl+e",
        "mac": "cmd+e cmd+e",
        "when": "editorHasSelection && editorTextFocus"
      },
      {
        "command": "base64-tools.decode",
        "key": "ctrl+e ctrl+d",
        "mac": "cmd+e cmd+d",
        "when": "editorHasSelection && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  }
}
