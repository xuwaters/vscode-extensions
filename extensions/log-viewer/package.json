{
  "name": "wx-vsce-log-viewer",
  "displayName": "Log Viewer",
  "description": "Pretty viewer for .log files with ANSI escape sequence rendering",
  "version": "0.3.2",
  "private": true,
  "publisher": "weixu",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "logViewer.editor",
        "displayName": "Log Viewer",
        "selector": [
          {
            "filenamePattern": "*.log"
          },
          {
            "filenamePattern": "*.log.*"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "logViewer.openInLogViewer",
        "title": "Open in Log Viewer",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.openInTextEditor",
        "title": "Open in Text Editor",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.toggleAnsi",
        "title": "Toggle ANSI Color Rendering",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.toggleWrap",
        "title": "Toggle Word Wrap",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.focusSearch",
        "title": "Focus Search Box",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.toggleFilterMode",
        "title": "Toggle Filter Mode (Highlight / Only Matching)",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.fontSizeIncrease",
        "title": "Increase Font Size",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.fontSizeDecrease",
        "title": "Decrease Font Size",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.fontSizeReset",
        "title": "Reset Font Size",
        "category": "Log Viewer"
      },
      {
        "command": "logViewer.editFilterSets",
        "title": "Edit Filter Sets",
        "category": "Log Viewer"
      }
    ],
    "keybindings": [
      {
        "command": "logViewer.focusSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'logViewer.editor'"
      },
      {
        "command": "logViewer.fontSizeIncrease",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == 'logViewer.editor'"
      },
      {
        "command": "logViewer.fontSizeDecrease",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == 'logViewer.editor'"
      },
      {
        "command": "logViewer.fontSizeReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == 'logViewer.editor'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "logViewer.openInTextEditor",
          "when": "activeCustomEditorId == 'logViewer.editor'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Log Viewer",
      "properties": {
        "logViewer.renderAnsi": {
          "type": "boolean",
          "default": true,
          "description": "Render ANSI terminal escape sequences as colored text. When disabled, raw escape sequences are shown."
        },
        "logViewer.wordWrap": {
          "type": "boolean",
          "default": false,
          "description": "Wrap long lines in the log viewer."
        },
        "logViewer.maxFileSizeBytes": {
          "type": "number",
          "default": 8388608,
          "description": "Maximum log file size to render (default 8 MB). Larger files fall back to raw text."
        },
        "logViewer.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 48,
          "description": "Font size in px for the log viewer. 0 means use the editor's default font size."
        },
        "logViewer.filterMode": {
          "type": "string",
          "default": "highlight",
          "enum": [
            "highlight",
            "only-matching"
          ],
          "enumDescriptions": [
            "Show all lines; matched lines are highlighted with their filter color",
            "Show only lines that match at least one enabled filter (or the search text)"
          ],
          "description": "How filter rules and the search box affect which lines are shown."
        },
        "logViewer.filters": {
          "type": "array",
          "default": [],
          "markdownDescription": "**Legacy** flat filter list. Prefer `logViewer.filterSets` instead. When `filterSets` is empty, these rules appear as a synthetic \"Default\" set. Example:\n\n```json\n[\n  { \"name\": \"Error\", \"pattern\": \"ERROR|FATAL\", \"regex\": true, \"color\": \"#5a1f1f\" },\n  { \"name\": \"Warn\", \"pattern\": \"WARN\", \"color\": \"#5a4a1f\" }\n]\n```",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pattern"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name shown on the toolbar chip."
              },
              "pattern": {
                "type": "string",
                "description": "Substring or regular expression to match against each line."
              },
              "regex": {
                "type": "boolean",
                "default": false,
                "description": "Treat 'pattern' as a JavaScript regular expression."
              },
              "caseSensitive": {
                "type": "boolean",
                "default": false,
                "description": "Match the pattern case-sensitively."
              },
              "color": {
                "type": "string",
                "description": "CSS color used as the line background highlight (e.g. '#5a1f1f' or 'rgba(255,0,0,0.15)')."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether this rule is enabled by default. Can be toggled at runtime from the toolbar."
              }
            }
          }
        },
        "logViewer.filterSets": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named groups of filter rules. Toggle entire sets on/off from the toolbar to switch between analysis scenarios (e.g. \"Login\", \"Audio\"). Edit interactively via the *Edit Filter Sets* command or the toolbar button.\n\n```json\n[\n  {\n    \"name\": \"Login\",\n    \"enabled\": true,\n    \"filters\": [\n      { \"name\": \"Auth Error\", \"pattern\": \"auth.*fail\", \"regex\": true, \"color\": \"#5a1f1f\" }\n    ]\n  }\n]\n```",
          "items": {
            "type": "object",
            "required": [
              "name",
              "filters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique display name for the set."
              },
              "description": {
                "type": "string",
                "description": "Optional notes about when to use this set."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether this set is active by default. Can be toggled at runtime from the toolbar."
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "pattern"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "regex": {
                      "type": "boolean",
                      "default": false
                    },
                    "caseSensitive": {
                      "type": "boolean",
                      "default": false
                    },
                    "color": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    }
                  }
                }
              }
            }
          }
        },
        "logViewer.colorPalette": {
          "type": "array",
          "default": [],
          "description": "Custom CSS colors appended to the built-in palette in the filter editor. Colors added via the editor's color picker are stored here.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cd ../../crates/log-parser && wasm-pack build --target nodejs --out-dir ../../extensions/log-viewer/wasm --out-name log_parser",
    "build": "tsdown",
    "clean": "rm -rf dist wasm",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "pnpm run build:wasm && tsdown --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  }
}
