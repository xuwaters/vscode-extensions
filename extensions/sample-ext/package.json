{
  "name": "@ext/sample-ext",
  "displayName": "Sample Extension",
  "description": "A sample Hello World VS Code extension",
  "version": "0.1.0",
  "private": true,
  "publisher": "xuwaters",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sample-ext.helloWorld",
        "title": "Hello World",
        "category": "Sample"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build && vsce package --no-dependencies",
    "vscode:prepublish": "tsdown --minify"
  },
  "dependencies": {
    "@ext/common": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0"
  }
}
