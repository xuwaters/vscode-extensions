{
  "name": "wx-vsce-wgsl-shader",
  "displayName": "WGSL / GLSL Shader",
  "description": "WGSL and GLSL shader language support with syntax highlighting, code completion, and validation (via naga WASM)",
  "version": "0.4.0",
  "private": true,
  "publisher": "weixu",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "wgsl",
        "aliases": [
          "WGSL",
          "wgsl"
        ],
        "extensions": [
          ".wgsl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "glsl",
        "aliases": [
          "GLSL",
          "OpenGL Shading Language",
          "glsl"
        ],
        "extensions": [
          ".glsl",
          ".vert",
          ".frag",
          ".comp",
          ".geom",
          ".tesc",
          ".tese",
          ".vsh",
          ".fsh",
          ".gsh",
          ".vshader",
          ".fshader",
          ".gshader",
          ".glslv",
          ".glslf",
          ".vertexshader",
          ".fragmentshader"
        ],
        "configuration": "./glsl-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wgsl",
        "scopeName": "source.wgsl",
        "path": "./syntaxes/wgsl.tmLanguage.json"
      },
      {
        "scopeName": "inline.wgsl",
        "path": "./syntaxes/wgsl-injection.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.wgsl": "wgsl"
        }
      },
      {
        "scopeName": "inline.rust.wgsl",
        "path": "./syntaxes/wgsl-rust-injection.tmLanguage.json",
        "injectTo": [
          "source.rust"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.wgsl": "wgsl"
        }
      },
      {
        "language": "glsl",
        "scopeName": "source.glsl",
        "path": "./syntaxes/glsl.tmLanguage.json"
      },
      {
        "scopeName": "inline.glsl",
        "path": "./syntaxes/glsl-injection.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.glsl": "glsl"
        }
      },
      {
        "scopeName": "inline.rust.glsl",
        "path": "./syntaxes/glsl-rust-injection.tmLanguage.json",
        "injectTo": [
          "source.rust"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.glsl": "glsl"
        }
      }
    ],
    "commands": [
      {
        "command": "wgsl.validateFile",
        "title": "WGSL: Validate Current File"
      },
      {
        "command": "glsl.validateFile",
        "title": "GLSL: Validate Current File"
      },
      {
        "command": "glsl.showShaderStage",
        "title": "GLSL: Show Shader Stage of Current File"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "wgsl.validateFile",
          "when": "editorLangId == wgsl"
        },
        {
          "command": "glsl.validateFile",
          "when": "editorLangId == glsl"
        },
        {
          "command": "glsl.showShaderStage",
          "when": "editorLangId == glsl"
        }
      ]
    },
    "configuration": {
      "title": "WGSL / GLSL Shader",
      "properties": {
        "glsl.validate.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate GLSL files on save"
        },
        "glsl.validate.onType": {
          "type": "boolean",
          "default": false,
          "description": "Validate GLSL files while typing"
        },
        "glsl.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code completion for GLSL"
        },
        "glsl.showStageInStatusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the shader stage a GLSL file is validated as in the status bar. GLSL has no in-file way to state its stage, so it is taken from `#pragma shader_stage(…)`, then the file extension, then the built-ins the source uses."
        },
        "wgsl.validate.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate WGSL files on save"
        },
        "wgsl.validate.onType": {
          "type": "boolean",
          "default": false,
          "description": "Validate WGSL files while typing"
        },
        "wgsl.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable code completion for WGSL"
        },
        "wgsl.rust.highlightHint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a Rust file embeds a shader with the `/* wgsl */` or `/* glsl */` tag, offer to turn off `#rust-analyzer.semanticHighlighting.strings.enable#`. rust-analyzer's semantic tokens override TextMate scopes, which hides the shader highlighting inside the string."
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cd ../../crates/wgsl-analyzer && wasm-pack build --target nodejs --out-dir ../../extensions/wgsl-shader/wasm --out-name wgsl_analyzer",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
