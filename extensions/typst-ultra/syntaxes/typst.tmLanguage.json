{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Typst",
  "scopeName": "source.typst",
  "_comment": "Deliberately minimal. This grammar only has to make a file look like Typst in the moments before semantic tokens arrive, and in themes or contexts where they do not. The real colouring comes from the actual parser via textDocument/semanticTokens — see decisions/0007. The one permanent exception is a raw block with a language tag: `source.typst.embedded` hands those to the language's own grammar, and the server emits no semantic tokens over them so nothing paints on top — see decisions/0013.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#heading" },
    { "include": "#math" },
    { "include": "source.typst.embedded" },
    { "include": "#raw-block" },
    { "include": "#raw-inline" },
    { "include": "#label" },
    { "include": "#reference" },
    { "include": "#strong" },
    { "include": "#emph" },
    { "include": "#list-marker" },
    { "include": "#hash-expression" },
    { "include": "#escape" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.typst",
          "match": "//.*$"
        },
        {
          "name": "comment.block.typst",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "heading": {
      "name": "markup.heading.typst",
      "match": "^\\s*=+\\s+.*$"
    },
    "math": {
      "name": "markup.math.typst",
      "begin": "\\$",
      "end": "\\$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.math.typst" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.math.typst" }
      },
      "patterns": [
        { "include": "#escape" },
        {
          "name": "keyword.operator.math.typst",
          "match": "[+\\-*/^_=<>&|]"
        }
      ]
    },
    "raw-block": {
      "_comment": "A raw block whose language tag matched nothing in `source.typst.embedded`, which is tried first — or one with no tag at all. The fence closes with the run of backticks that opened it, hence the back-reference.",
      "name": "markup.raw.block.typst",
      "begin": "(`{3,})([\\w+#-]*)",
      "end": "(\\1)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.raw.typst" },
        "2": { "name": "fenced_code.block.language.typst" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.raw.typst" }
      }
    },
    "raw-inline": {
      "name": "markup.raw.inline.typst",
      "match": "`[^`\\n]*`"
    },
    "label": {
      "name": "entity.name.label.typst",
      "match": "<[\\p{L}\\d_:.\\-]+>"
    },
    "reference": {
      "name": "markup.other.reference.typst",
      "match": "@[\\p{L}\\d_:.\\-]+"
    },
    "strong": {
      "name": "markup.bold.typst",
      "match": "\\*[^*\\n]+\\*"
    },
    "emph": {
      "name": "markup.italic.typst",
      "match": "_[^_\\n]+_"
    },
    "list-marker": {
      "name": "punctuation.definition.list.begin.typst",
      "match": "^\\s*([-+]|\\d+\\.)\\s"
    },
    "escape": {
      "name": "constant.character.escape.typst",
      "match": "\\\\(u\\{[0-9a-fA-F]+\\}|.)"
    },
    "hash-expression": {
      "patterns": [
        {
          "_comment": "A keyword after the hash, which is the shape most code-mode lines take.",
          "match": "#(let|set|show|import|include|if|else|for|while|return|break|continue|context|as|in|not|and|or|none|auto|true|false)\\b",
          "captures": {
            "1": { "name": "keyword.control.typst" }
          }
        },
        {
          "_comment": "A call or variable reference.",
          "match": "#([\\p{L}_][\\p{L}\\d_\\-]*)(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.typst" }
          }
        },
        {
          "match": "#([\\p{L}_][\\p{L}\\d_\\-]*)",
          "captures": {
            "1": { "name": "variable.other.typst" }
          }
        }
      ]
    }
  }
}
