{
  "name": "wx-vsce-typst-ultra",
  "displayName": "Typst Ultra",
  "description": "Typst language server and live preview on unmodified upstream typst, compiled to a single WASM artifact — diagnostics, completion, hover, goto-definition, semantic tokens, formatting, BibTeX bibliographies, two-way-synced preview, and PDF/SVG/PNG export",
  "version": "0.13.0",
  "private": true,
  "publisher": "weixu",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typst",
    "onLanguage:bibtex",
    "onWebviewPanel:typstUltra.preview",
    "onCustomEditor:typstUltra.editor",
    "onCommand:typstUltra.newFromTemplate"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "weixu.wx-vsce-typst-ultra-fonts"
  ],
  "contributes": {
    "languages": [
      {
        "id": "typst",
        "aliases": [
          "Typst",
          "typst"
        ],
        "extensions": [
          ".typ",
          ".typc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bibtex",
        "aliases": [
          "BibTeX",
          "bibtex"
        ],
        "extensions": [
          ".bib"
        ],
        "configuration": "./language-configuration-bibtex.json"
      }
    ],
    "grammars": [
      {
        "language": "typst",
        "scopeName": "source.typst",
        "path": "./syntaxes/typst.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.bat": "bat",
          "meta.embedded.block.bibtex": "bibtex",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.capnp": "capnp",
          "meta.embedded.block.clojure": "clojure",
          "meta.embedded.block.coffeescript": "coffeescript",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.cuda-cpp": "cuda-cpp",
          "meta.embedded.block.dart": "dart",
          "meta.embedded.block.diff": "diff",
          "meta.embedded.block.dockerfile": "dockerfile",
          "meta.embedded.block.dotenv": "dotenv",
          "meta.embedded.block.elixir": "elixir",
          "meta.embedded.block.erlang": "erlang",
          "meta.embedded.block.fsharp": "fsharp",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.graphql": "graphql",
          "meta.embedded.block.groovy": "groovy",
          "meta.embedded.block.handlebars": "handlebars",
          "meta.embedded.block.haskell": "haskell",
          "meta.embedded.block.hlsl": "hlsl",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.ignore": "ignore",
          "meta.embedded.block.ini": "ini",
          "meta.embedded.block.jade": "jade",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.javascriptreact": "javascriptreact",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.jsonc": "jsonc",
          "meta.embedded.block.jsonl": "jsonl",
          "meta.embedded.block.julia": "julia",
          "meta.embedded.block.kotlin": "kotlin",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.less": "less",
          "meta.embedded.block.lua": "lua",
          "meta.embedded.block.makefile": "makefile",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.nix": "nix",
          "meta.embedded.block.objective-c": "objective-c",
          "meta.embedded.block.objective-cpp": "objective-cpp",
          "meta.embedded.block.ocaml": "ocaml",
          "meta.embedded.block.perl": "perl",
          "meta.embedded.block.php": "php",
          "meta.embedded.block.powershell": "powershell",
          "meta.embedded.block.proto3": "proto3",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.r": "r",
          "meta.embedded.block.restructuredtext": "restructuredtext",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.scala": "scala",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.shaderlab": "shaderlab",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.svelte": "svelte",
          "meta.embedded.block.swift": "swift",
          "meta.embedded.block.terraform": "terraform",
          "meta.embedded.block.toml": "toml",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.typescriptreact": "typescriptreact",
          "meta.embedded.block.typst": "typst",
          "meta.embedded.block.vb": "vb",
          "meta.embedded.block.vue": "vue",
          "meta.embedded.block.wat": "wat",
          "meta.embedded.block.wgsl": "wgsl",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.xsl": "xsl",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.zig": "zig"
        }
      },
      {
        "scopeName": "source.typst.embedded",
        "path": "./syntaxes/typst-embedded.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "typst",
        "path": "./snippets/typst.json"
      }
    ],
    "configurationDefaults": {
      "[typst]": {
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        },
        "editor.acceptSuggestionOnEnter": "off"
      }
    },
    "customEditors": [
      {
        "viewType": "typstUltra.editor",
        "displayName": "Typst Preview",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.typ"
          }
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "typst",
        "scopes": {
          "punct": [
            "punctuation.typst"
          ],
          "escape": [
            "constant.character.escape.typst"
          ],
          "strong": [
            "markup.bold.typst"
          ],
          "emph": [
            "markup.italic.typst"
          ],
          "link": [
            "markup.underline.link.typst"
          ],
          "raw": [
            "markup.raw.typst"
          ],
          "label": [
            "entity.name.label.typst"
          ],
          "ref": [
            "markup.other.reference.typst"
          ],
          "heading": [
            "markup.heading.typst"
          ],
          "listMarker": [
            "punctuation.definition.list.begin.typst"
          ],
          "listTerm": [
            "markup.bold.typst"
          ],
          "mathDelimiter": [
            "punctuation.definition.math.typst"
          ],
          "interpolated": [
            "meta.interpolation.typst"
          ],
          "error": [
            "invalid.illegal.typst"
          ]
        }
      },
      {
        "language": "bibtex",
        "scopes": {
          "label": [
            "entity.name.type.entry-key.bibtex",
            "entity.name.label"
          ],
          "punct": [
            "punctuation.definition.keyword.bibtex",
            "punctuation"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "typstUltra.newFromTemplate",
        "title": "New Project from Template…",
        "category": "Typst Ultra",
        "icon": "$(new-folder)"
      },
      {
        "command": "typstUltra.showPreview",
        "title": "Open Preview",
        "category": "Typst Ultra",
        "icon": "$(open-preview)"
      },
      {
        "command": "typstUltra.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "Typst Ultra",
        "icon": "$(open-preview)"
      },
      {
        "command": "typstUltra.setModeEdit",
        "title": "Switch to Edit View",
        "category": "Typst Ultra",
        "icon": "$(edit)"
      },
      {
        "command": "typstUltra.setModeSplit",
        "title": "Switch to Split View",
        "category": "Typst Ultra",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "typstUltra.setModePreview",
        "title": "Switch to Preview View",
        "category": "Typst Ultra",
        "icon": "$(preview)"
      },
      {
        "command": "typstUltra.cycleMode",
        "title": "Cycle View Mode (Edit / Split / Preview)",
        "category": "Typst Ultra",
        "icon": "$(layout)"
      },
      {
        "command": "typstUltra.switchMode",
        "title": "Switch View Mode…",
        "category": "Typst Ultra",
        "icon": "$(layout)"
      },
      {
        "command": "typstUltra.toggleEditPreview",
        "title": "Toggle Edit / Preview View",
        "category": "Typst Ultra",
        "icon": "$(preview)"
      },
      {
        "command": "typstUltra.toggleFocus",
        "title": "Toggle Focus Between Editor and Preview",
        "category": "Typst Ultra",
        "icon": "$(eye)"
      },
      {
        "command": "typstUltra.togglePreviewLock",
        "title": "Toggle Preview Pin (Follow Active Editor)",
        "category": "Typst Ultra",
        "icon": "$(pin)"
      },
      {
        "command": "typstUltra.syncPreviewToCursor",
        "title": "Sync Preview to Cursor",
        "category": "Typst Ultra"
      },
      {
        "command": "typstUltra.pinMain",
        "title": "Pin This File as Compile Root",
        "category": "Typst Ultra",
        "icon": "$(pin)"
      },
      {
        "command": "typstUltra.unpinMain",
        "title": "Unpin Compile Root",
        "category": "Typst Ultra",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "typstUltra.selectMain",
        "title": "Select Compile Root…",
        "category": "Typst Ultra",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "typstUltra.export",
        "title": "Export…",
        "category": "Typst Ultra",
        "icon": "$(export)"
      },
      {
        "command": "typstUltra.exportPdf",
        "title": "Export PDF",
        "category": "Typst Ultra",
        "icon": "$(export)"
      },
      {
        "command": "typstUltra.toggleInvertColors",
        "title": "Toggle Preview Color Inversion",
        "category": "Typst Ultra",
        "icon": "$(color-mode)"
      },
      {
        "command": "typstUltra.restartServer",
        "title": "Restart Language Server",
        "category": "Typst Ultra"
      },
      {
        "command": "typstUltra.showLog",
        "title": "Show Log",
        "category": "Typst Ultra"
      },
      {
        "command": "typstUltra.clearPackageCache",
        "title": "Clear Package Cache",
        "category": "Typst Ultra"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "typstUltra.showPreview",
          "when": "editorLangId == typst"
        },
        {
          "command": "typstUltra.showPreviewToSide",
          "when": "editorLangId == typst"
        },
        {
          "command": "typstUltra.setModeEdit",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.setModeSplit",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.setModePreview",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.cycleMode",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.switchMode",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.toggleEditPreview",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.toggleFocus",
          "when": "editorLangId == typst || typstUltra.previewVisible"
        },
        {
          "command": "typstUltra.togglePreviewLock",
          "when": "typstUltra.previewVisible"
        },
        {
          "command": "typstUltra.syncPreviewToCursor",
          "when": "editorLangId == typst && typstUltra.previewVisible"
        },
        {
          "command": "typstUltra.pinMain",
          "when": "editorLangId == typst"
        },
        {
          "command": "typstUltra.unpinMain",
          "when": "typstUltra.mainPinned"
        },
        {
          "command": "typstUltra.selectMain",
          "when": "editorLangId == typst"
        },
        {
          "command": "typstUltra.export",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.exportPdf",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.toggleInvertColors",
          "when": "typstUltra.previewVisible || activeCustomEditorId == typstUltra.editor"
        },
        {
          "command": "typstUltra.newFromTemplate"
        }
      ],
      "editor/title": [
        {
          "command": "typstUltra.setModeEdit",
          "when": "(editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor) && typstUltra.mode != edit",
          "group": "navigation@1"
        },
        {
          "command": "typstUltra.setModePreview",
          "when": "(editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor) && typstUltra.mode != preview",
          "group": "navigation@2"
        },
        {
          "command": "typstUltra.setModeSplit",
          "when": "(editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor) && typstUltra.mode != split",
          "group": "navigation@3"
        },
        {
          "command": "typstUltra.export",
          "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor",
          "group": "navigation@4"
        },
        {
          "command": "typstUltra.toggleFocus",
          "when": "editorLangId == typst && typstUltra.previewVisible",
          "group": "navigation@5"
        },
        {
          "command": "typstUltra.togglePreviewLock",
          "when": "activeWebviewPanelId == typstUltra.preview",
          "group": "navigation@6"
        }
      ],
      "explorer/context": [
        {
          "command": "typstUltra.showPreview",
          "when": "resourceExtname == .typ",
          "group": "navigation"
        },
        {
          "command": "typstUltra.export",
          "when": "resourceExtname == .typ",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "typstUltra.setModeSplit",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
      },
      {
        "command": "typstUltra.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == typst"
      },
      {
        "command": "typstUltra.toggleFocus",
        "key": "ctrl+k ctrl+v",
        "mac": "cmd+k cmd+v",
        "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview"
      },
      {
        "command": "typstUltra.cycleMode",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m",
        "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
      },
      {
        "command": "typstUltra.toggleEditPreview",
        "key": "ctrl+k ctrl+p",
        "mac": "cmd+k cmd+p",
        "when": "editorLangId == typst || activeWebviewPanelId == typstUltra.preview || activeCustomEditorId == typstUltra.editor"
      },
      {
        "command": "typstUltra.togglePreviewLock",
        "key": "ctrl+k ctrl+l",
        "mac": "cmd+k cmd+l",
        "when": "activeWebviewPanelId == typstUltra.preview"
      },
      {
        "command": "typstUltra.syncPreviewToCursor",
        "key": "ctrl+k ctrl+j",
        "mac": "cmd+k cmd+j",
        "when": "editorLangId == typst"
      }
    ],
    "configuration": {
      "title": "Typst Ultra",
      "properties": {
        "typstUltra.rootPath": {
          "type": "string",
          "default": "",
          "description": "Compile root. Empty follows the workspace folder. Determines what an absolute path like `/assets/logo.svg` means inside a document."
        },
        "typstUltra.mainFile": {
          "type": "string",
          "default": "",
          "description": "Compile and preview entry point, workspace-relative. The preview shows this file whichever part of the project you are editing. Empty follows the focused editor. Outranked by the `Typst: Pin This File as Compile Root` command."
        },
        "typstUltra.compile.when": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "never"
          ],
          "default": "onType",
          "description": "When to recompile."
        },
        "typstUltra.compile.debounce": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 5000,
          "description": "Milliseconds of quiet after the last keystroke before compiling."
        },
        "typstUltra.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show typst's errors and warnings."
        },
        "typstUltra.semanticTokens": {
          "type": "string",
          "enum": [
            "enable",
            "disable"
          ],
          "default": "enable",
          "description": "Colour from the real parser. Disabling falls back to the bundled grammar's approximate colouring."
        },
        "typstUltra.formatter.mode": {
          "type": "string",
          "enum": [
            "typstyle",
            "off"
          ],
          "default": "typstyle",
          "description": "Formatter to use."
        },
        "typstUltra.formatter.printWidth": {
          "type": "number",
          "default": 80,
          "minimum": 20,
          "maximum": 400,
          "description": "Target line width for the formatter."
        },
        "typstUltra.formatter.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Spaces per indent level."
        },
        "typstUltra.inlayHints.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show parameter names at call sites."
        },
        "typstUltra.fonts.system": {
          "type": "boolean",
          "default": true,
          "description": "Index fonts installed on this machine, in the background, after the bundled set is live."
        },
        "typstUltra.fonts.paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra font directories, workspace-relative or absolute."
        },
        "typstUltra.packages.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow downloading packages from the registry. Turn off for air-gapped setups; imports then fail with a clear message instead of hanging."
        },
        "typstUltra.packages.registry": {
          "type": "string",
          "default": "https://packages.typst.org",
          "description": "Package registry base URL."
        },
        "typstUltra.packages.cachePath": {
          "type": "string",
          "default": "",
          "description": "Package cache directory. Empty uses typst's standard location, shared with `typst-cli` so nothing is downloaded twice."
        },
        "typstUltra.preview.defaultMode": {
          "type": "string",
          "enum": [
            "split",
            "preview"
          ],
          "default": "split",
          "description": "View mode used when opening a preview without an explicit placement."
        },
        "typstUltra.preview.lockPreviewGroup": {
          "type": "boolean",
          "default": true,
          "description": "Lock the editor group the side preview opens in, so newly-opened files land in the main group instead of replacing the preview."
        },
        "typstUltra.preview.scrollSync": {
          "type": "string",
          "enum": [
            "both",
            "editorToPreview",
            "previewToEditor",
            "off"
          ],
          "default": "both",
          "description": "Which directions the editor and preview follow each other."
        },
        "typstUltra.preview.cursorIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Flash a marker at the cursor's position on the page."
        },
        "typstUltra.preview.invertColors": {
          "type": "string",
          "enum": [
            "never",
            "always",
            "auto"
          ],
          "default": "never",
          "description": "Invert page colours for reading white pages in a dark editor. Images are exempt. `auto` follows the VSCode theme."
        },
        "typstUltra.preview.background": {
          "type": "string",
          "enum": [
            "editor",
            "white",
            "gray"
          ],
          "default": "editor",
          "description": "Colour behind the pages."
        },
        "typstUltra.preview.renderMode": {
          "type": "string",
          "enum": [
            "svg",
            "png",
            "auto"
          ],
          "default": "svg",
          "description": "How pages are rendered. `png` is a low-memory mode that loses zoom fidelity and find-in-preview; `auto` switches per page above roughly 1 MB of SVG."
        },
        "typstUltra.export.outputPath": {
          "type": "string",
          "default": "$dir/$name",
          "description": "Where exports are written, without the extension. Supports `$dir`, `$name`, and `$root`. This is what the export dialog opens on — by default the document's own folder, under the document's own name."
        },
        "typstUltra.export.askForLocation": {
          "type": "boolean",
          "default": true,
          "description": "Ask where to save on every export, starting at `export.outputPath`. Turn off to write straight to that path without confirming."
        },
        "typstUltra.memory.evictAge": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 30,
          "description": "comemo cache age. Lower is both faster and smaller here — measured, and counter-intuitive. Deviates from typst-cli's 10 on purpose."
        },
        "typstUltra.memory.restartThresholdMb": {
          "type": "number",
          "default": 1024,
          "minimum": 0,
          "description": "Offer a server restart once its heap passes this size. 0 disables the watchdog."
        },
        "typstUltra.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the output channel."
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cd ../../crates/typst/typst-lsp-wasm && wasm-pack build --target nodejs --out-dir ../../../extensions/typst-ultra/wasm --out-name typst_lsp_wasm",
    "build:fonts": "pnpm --filter wx-vsce-typst-ultra-fonts run build:fonts",
    "build:grammar": "node scripts/embedded/generate.mjs",
    "licenses": "cd ../../crates/typst/typst-lsp-wasm && cargo about generate about.hbs -o ../../../extensions/typst-ultra/THIRD-PARTY-NOTICES.md",
    "build": "tsdown",
    "clean": "rm -rf dist wasm",
    "typecheck": "tsc --noEmit && tsc -p webview --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "pnpm run build:wasm && tsdown --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
