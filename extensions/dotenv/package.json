{
  "name": "wx-vsce-dotenv",
  "displayName": "dotenv (.env)",
  "description": "dotenv (.env) editing — syntax highlighting, diagnostics, formatting, outline, and variable-reference completion powered by a dotent analyzer compiled to WebAssembly.",
  "version": "0.2.2",
  "private": true,
  "publisher": "weixu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuwaters/vscode-extensions.git",
    "directory": "extensions/dotenv"
  },
  "bugs": {
    "url": "https://github.com/xuwaters/vscode-extensions/issues"
  },
  "homepage": "https://github.com/xuwaters/vscode-extensions/tree/main/extensions/dotenv#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:dotenv"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dotenv",
        "aliases": [
          "dotenv",
          ".env"
        ],
        "extensions": [
          ".env"
        ],
        "filenames": [
          ".env",
          ".env.local",
          ".env.development",
          ".env.development.local",
          ".env.production",
          ".env.production.local",
          ".env.test",
          ".env.test.local",
          ".env.staging",
          ".env.example",
          ".env.sample",
          ".env.template",
          ".env.defaults"
        ],
        "filenamePatterns": [
          ".env.*",
          "*.env",
          "*.env.local",
          "*.env.development",
          "*.env.development.local",
          "*.env.production",
          "*.env.production.local",
          "*.env.test",
          "*.env.test.local",
          "*.env.staging",
          "*.env.example",
          "*.env.sample",
          "*.env.template",
          "*.env.defaults"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dotenv",
        "scopeName": "source.dotenv",
        "path": "./syntaxes/dotenv.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "dotenv",
      "properties": {
        "dotenv.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Emit diagnostics for malformed assignments, unclosed quotes, duplicate keys, and unknown variable references."
        },
        "dotenv.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Recompute diagnostics as you type (debounced). Turn off to only recompute on save."
        },
        "dotenv.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Suggest keys defined in the current file when typing `$` or `${` inside a value."
        },
        "dotenv.format.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Format `.env` files: drop indentation and trailing whitespace, close up spaces around `=`, and collapse blank-line runs. Values are never rewritten, and keys are never reordered."
        },
        "dotenv.format.maxBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Maximum consecutive blank lines to keep when formatting. Blank lines at the start and end of the file are always removed."
        },
        "dotenv.format.insertFinalNewline": {
          "type": "boolean",
          "default": true,
          "description": "End the formatted file with exactly one newline."
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cd ../../crates/dotenv-analyzer && wasm-pack build --target nodejs --out-dir ../../extensions/dotenv/wasm --out-name dotenv_analyzer",
    "licenses": "cd ../../crates/dotenv-analyzer && cargo about generate about.hbs -o ../../extensions/dotenv/THIRD-PARTY-NOTICES.md",
    "build": "tsdown",
    "clean": "rm -rf dist wasm",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  }
}
