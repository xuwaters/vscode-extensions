{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "dotenv",
  "scopeName": "source.dotenv",
  "patterns": [
    { "include": "#comment" },
    { "include": "#assignment" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.dotenv" }
      },
      "name": "comment.line.number-sign.dotenv"
    },
    "assignment": {
      "begin": "^\\s*(?:(export)\\s+)?([A-Za-z_][A-Za-z0-9_.]*)\\s*(=)",
      "beginCaptures": {
        "1": { "name": "keyword.control.export.dotenv" },
        "2": { "name": "variable.other.dotenv" },
        "3": { "name": "keyword.operator.assignment.dotenv" }
      },
      "end": "(?=$)",
      "patterns": [
        { "include": "#value" }
      ]
    },
    "value": {
      "patterns": [
        { "include": "#string-double" },
        { "include": "#string-single" },
        { "include": "#string-backtick" },
        { "include": "#inline-comment" },
        { "include": "#variable-reference" },
        { "include": "#unquoted-value" }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.dotenv",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dotenv" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dotenv" }
      },
      "patterns": [
        { "include": "#escape" },
        { "include": "#variable-reference" }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.dotenv",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dotenv" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dotenv" }
      }
    },
    "string-backtick": {
      "name": "string.interpolated.dotenv",
      "begin": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dotenv" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dotenv" }
      },
      "patterns": [
        { "include": "#variable-reference" }
      ]
    },
    "escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.dotenv"
    },
    "variable-reference": {
      "patterns": [
        {
          "match": "\\$\\{([A-Za-z_][A-Za-z0-9_]*)(?::[-?+=]?[^}]*)?\\}",
          "captures": {
            "0": { "name": "variable.other.placeholder.dotenv" },
            "1": { "name": "variable.other.name.dotenv" }
          }
        },
        {
          "match": "\\$([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "variable.other.placeholder.dotenv" },
            "1": { "name": "variable.other.name.dotenv" }
          }
        }
      ]
    },
    "inline-comment": {
      "match": "(?<=\\s)(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.dotenv" }
      },
      "name": "comment.line.number-sign.dotenv"
    },
    "unquoted-value": {
      "match": "[^\\s\"'`#$]+",
      "name": "string.unquoted.dotenv"
    }
  }
}
