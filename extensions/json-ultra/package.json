{
  "name": "wx-vsce-json-ultra",
  "displayName": "JSON Ultra",
  "description": "JSON, JSONC, JSON5, and JSON Lines — diagnostics, comment-preserving formatting with optional recursive key sort, outline, folding, JSON-path hovers, a JSON Lines table preview, and oxfmt delegation — powered by a Rust parser compiled to WebAssembly.",
  "version": "0.2.0",
  "private": true,
  "publisher": "weixu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:json5",
    "onLanguage:jsonl",
    "onCustomEditor:jsonUltra.jsonlPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "json5",
        "aliases": [
          "JSON5"
        ],
        "extensions": [
          ".json5"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonl",
        "aliases": [
          "JSON Lines"
        ],
        "extensions": [
          ".jsonl",
          ".ndjson"
        ]
      }
    ],
    "grammars": [
      {
        "language": "json5",
        "scopeName": "source.json5",
        "path": "./syntaxes/json5.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "jsonUltra.jsonlPreview",
        "displayName": "JSON Lines Table",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "jsonUltra.sortKeys",
        "category": "JSON Ultra",
        "title": "Sort Object Keys Recursively"
      },
      {
        "command": "jsonUltra.openPreview",
        "category": "JSON Ultra",
        "title": "Open JSON Lines Table",
        "icon": "$(table)"
      },
      {
        "command": "jsonUltra.openPreviewToSide",
        "category": "JSON Ultra",
        "title": "Open JSON Lines Table to the Side"
      },
      {
        "command": "jsonUltra.openInTextEditor",
        "category": "JSON Ultra",
        "title": "Reopen in Text Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jsonUltra.showLog",
        "category": "JSON Ultra",
        "title": "Show Log"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jsonUltra.sortKeys",
          "when": "editorLangId =~ /^(json|jsonc|json5|jsonl)$/"
        },
        {
          "command": "jsonUltra.openPreview",
          "when": "resourceExtname =~ /^\\.(jsonl|ndjson)$/i"
        },
        {
          "command": "jsonUltra.openPreviewToSide",
          "when": "resourceExtname =~ /^\\.(jsonl|ndjson)$/i"
        },
        {
          "command": "jsonUltra.openInTextEditor",
          "when": "activeCustomEditorId == 'jsonUltra.jsonlPreview'"
        }
      ],
      "editor/title": [
        {
          "command": "jsonUltra.openPreview",
          "when": "resourceExtname =~ /^\\.(jsonl|ndjson)$/i && activeCustomEditorId != 'jsonUltra.jsonlPreview'",
          "group": "navigation@1"
        },
        {
          "command": "jsonUltra.openInTextEditor",
          "when": "activeCustomEditorId == 'jsonUltra.jsonlPreview'",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "JSON Ultra",
      "properties": {
        "jsonUltra.format.sortKeys": {
          "type": "boolean",
          "default": false,
          "scope": "language-overridable",
          "description": "Sort object keys recursively whenever a document is formatted. The standalone \"Sort Object Keys Recursively\" command works regardless of this setting."
        },
        "jsonUltra.format.oxc": {
          "type": "string",
          "enum": [
            "auto",
            "never"
          ],
          "enumDescriptions": [
            "Format with the workspace's oxfmt when an oxfmt config file (.oxfmtrc.json, .oxfmtrc.jsonc, oxfmt.config.ts, oxfmt.config.mts) is present; fall back to the built-in formatter otherwise.",
            "Always use the built-in formatter."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Delegate JSON formatting to oxc's oxfmt when the project is configured for it."
        },
        "jsonUltra.oxc.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Explicit path to an oxfmt binary. Empty resolves node_modules/.bin/oxfmt from the workspace, then PATH."
        },
        "jsonUltra.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report parse errors for JSON5 and JSON Lines files. (JSON and JSONC are validated by VSCode's built-in language service.)"
        },
        "jsonUltra.preview.maxRows": {
          "type": "number",
          "default": 100000,
          "minimum": 1,
          "maximum": 10000000,
          "description": "Upper bound on rows shown by the JSON Lines table preview."
        },
        "jsonUltra.preview.maxFileSizeBytes": {
          "type": "number",
          "default": 33554432,
          "minimum": 1024,
          "description": "Files larger than this many bytes are refused by the JSON Lines table preview."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:wasm": "cd ../../crates/json-analyzer && wasm-pack build --target nodejs --out-dir ../../extensions/json-ultra/wasm --out-name json_analyzer",
    "clean": "rm -rf dist wasm",
    "typecheck": "tsc --noEmit && tsc -p webview --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  }
}
