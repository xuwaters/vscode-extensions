{
  "name": "wx-vsce-markdown-live-preview",
  "displayName": "Markdown Preview",
  "description": "Live Markdown preview with math (KaTeX), mermaid diagrams, syntax highlighting, and editor scroll sync",
  "version": "0.3.0",
  "private": true,
  "publisher": "weixu",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownLivePreview.showPreview",
        "title": "Open Preview",
        "category": "Markdown Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownLivePreview.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "Markdown Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownLivePreview.showPreview",
          "when": "editorLangId == markdown || editorLangId == mdx || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx"
        },
        {
          "command": "markdownLivePreview.showPreviewToSide",
          "when": "editorLangId == markdown || editorLangId == mdx || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx"
        }
      ],
      "editor/title": [
        {
          "command": "markdownLivePreview.showPreviewToSide",
          "when": "editorLangId == markdown || editorLangId == mdx || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownLivePreview.showPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownLivePreview.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown || editorLangId == mdx"
      },
      {
        "command": "markdownLivePreview.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == markdown || editorLangId == mdx"
      }
    ],
    "configuration": {
      "title": "Markdown Preview",
      "properties": {
        "markdownLivePreview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Keep the preview scrolled to the editor's top visible line."
        },
        "markdownLivePreview.breaks": {
          "type": "boolean",
          "default": false,
          "description": "Render a single newline inside a paragraph as a line break."
        },
        "markdownLivePreview.linkify": {
          "type": "boolean",
          "default": true,
          "description": "Automatically turn bare URLs into clickable links."
        },
        "markdownLivePreview.math.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render LaTeX math expressions ($inline$ and $$display$$) via KaTeX."
        },
        "markdownLivePreview.mermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render ```mermaid fenced code blocks as diagrams."
        },
        "markdownLivePreview.frontmatter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render leading YAML frontmatter as a styled metadata card."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.0",
    "markdown-it": "^14.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.0",
    "markdown-it-task-lists": "^2.1.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.0.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.21.4",
    "@types/js-yaml": "^4.0.0",
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  }
}
