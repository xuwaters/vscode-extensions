{
  "$comment": "Injection grammar: HTML inside FAST's html`` templates and CSS inside css``, written for this extension (not vendored from vscode-lit-html — task P5-01 chose write-our-own to avoid carrying a fork of another grammar). This half only opens the template and hands the body over; everything that has to keep working *inside* the body — ${…} and FAST's :/?/@ binding prefixes — lives in `fast-element-embedded.injection.json`, because this selector's `-string` switches the whole grammar off the moment the template's own `string.template.fast-element.ts` scope is on the stack.",
  "scopeName": "inline.fast-element-html",
  "injectionSelector": "L:source.ts -comment -string, L:source.tsx -comment -string, L:source.js -comment -string, L:source.jsx -comment -string",
  "patterns": [
    { "include": "#fastHtmlTemplate" },
    { "include": "#fastCssTemplate" }
  ],
  "repository": {
    "fastHtmlTemplate": {
      "begin": "(?x)(\\bhtml)\\s*(?:(<)[^<>`]{0,240}(>))?\\s*(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.ts" },
        "2": { "name": "punctuation.definition.typeparameters.begin.ts" },
        "3": { "name": "punctuation.definition.typeparameters.end.ts" },
        "4": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "name": "string.template.fast-element.ts",
      "contentName": "meta.embedded.block.html",
      "patterns": [{ "include": "text.html.basic" }]
    },
    "fastCssTemplate": {
      "begin": "(?x)(\\bcss)\\s*(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.ts" },
        "2": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "name": "string.template.fast-element.ts",
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    }
  }
}
