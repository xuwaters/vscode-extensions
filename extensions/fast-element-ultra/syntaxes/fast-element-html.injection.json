{
  "$comment": "Injection grammar: HTML inside FAST's html`` templates and CSS inside css``, written for this extension (not vendored from vscode-lit-html — task P5-01 chose write-our-own to avoid carrying a fork of another grammar). FAST's binding prefixes (:, ?, @) are captured where the HTML grammar leaves room; interpolations re-enter TypeScript.",
  "scopeName": "inline.fast-element-html",
  "injectionSelector": "L:source.ts -comment -string, L:source.tsx -comment -string, L:source.js -comment -string, L:source.jsx -comment -string",
  "patterns": [
    { "include": "#fastHtmlTemplate" },
    { "include": "#fastCssTemplate" }
  ],
  "repository": {
    "fastHtmlTemplate": {
      "begin": "(?x)(\\bhtml)\\s*(?:(<)[^<>`]{0,240}(>))?\\s*(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.ts" },
        "2": { "name": "punctuation.definition.typeparameters.begin.ts" },
        "3": { "name": "punctuation.definition.typeparameters.end.ts" },
        "4": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "name": "string.template.fast-element.ts",
      "contentName": "meta.embedded.block.html",
      "patterns": [
        { "include": "#templateInterpolation" },
        { "include": "#fastBindingAttribute" },
        { "include": "text.html.basic" }
      ]
    },
    "fastCssTemplate": {
      "begin": "(?x)(\\bcss)\\s*(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.ts" },
        "2": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "name": "string.template.fast-element.ts",
      "contentName": "meta.embedded.block.css",
      "patterns": [
        { "include": "#templateInterpolation" },
        { "include": "source.css" }
      ]
    },
    "templateInterpolation": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.ts" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.ts" }
      },
      "name": "meta.template.expression.ts",
      "contentName": "meta.embedded.line.ts",
      "patterns": [{ "include": "source.ts" }]
    },
    "fastBindingAttribute": {
      "match": "(?<=[\\s\"'])([:?@])([a-zA-Z][\\w.-]*)(?=\\s*=)",
      "captures": {
        "1": { "name": "keyword.operator.binding.fast-element punctuation.definition.binding.fast-element" },
        "2": { "name": "entity.other.attribute-name.binding.fast-element" }
      }
    }
  }
}
