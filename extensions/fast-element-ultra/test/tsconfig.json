{
  // Tests run under vitest as ESM, so `import.meta` is legal here; the
  // package root stays Node16/CJS for the two bundles.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [".", "../tsplugin"]
}
