{
  "name": "wx-vsce-capnproto",
  "displayName": "Cap'n Proto Ultra",
  "description": "Cap'n Proto (.capnp) schema editing — syntax highlighting, outline, and diagnostics powered by a Rust analyzer compiled to WebAssembly.",
  "version": "0.3.5",
  "private": true,
  "publisher": "weixu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuwaters/vscode-extensions.git",
    "directory": "extensions/capnproto"
  },
  "bugs": {
    "url": "https://github.com/xuwaters/vscode-extensions/issues"
  },
  "homepage": "https://github.com/xuwaters/vscode-extensions/tree/main/extensions/capnproto#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:capnp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "capnp",
        "aliases": [
          "Cap'n Proto",
          "capnp",
          "capnproto"
        ],
        "extensions": [
          ".capnp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "capnp",
        "scopeName": "source.capnp",
        "path": "./syntaxes/capnp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "capnp.restart",
        "title": "Cap'n Proto: Restart Analyzer",
        "category": "Cap'n Proto"
      }
    ],
    "configuration": {
      "title": "Cap'n Proto",
      "properties": {
        "capnp.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional include paths for `using X = import \"…\"` resolution. Workspace-relative or absolute. Workspace roots are always searched in addition to this list."
        },
        "capnp.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Emit diagnostics for parse errors, missing file ids, and duplicate ordinals."
        },
        "capnp.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Recompute diagnostics as you type (debounced). Turn off to only recompute on save."
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cd ../../crates/capnp-analyzer && wasm-pack build --target nodejs --out-dir ../../extensions/capnproto/wasm --out-name capnp_analyzer",
    "licenses": "cd ../../crates/capnp-analyzer && cargo about generate about.hbs -o ../../extensions/capnproto/THIRD-PARTY-NOTICES.md",
    "build": "tsdown",
    "clean": "rm -rf dist wasm",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  }
}
