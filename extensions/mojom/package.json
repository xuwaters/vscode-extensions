{
  "name": "wx-vsce-mojom",
  "displayName": "Mojom IDL Ultra",
  "description": "Mojom (.mojom) interface definition editing — syntax highlighting, outline, navigation, and diagnostics powered by a Rust analyzer compiled to WebAssembly.",
  "version": "0.1.0",
  "private": true,
  "publisher": "weixu",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:mojom"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mojom",
        "aliases": [
          "Mojom",
          "mojom"
        ],
        "extensions": [
          ".mojom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mojom",
        "scopeName": "source.mojom",
        "path": "./syntaxes/mojom.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mojom.restart",
        "title": "Mojom: Restart Analyzer",
        "category": "Mojom"
      }
    ],
    "configuration": {
      "title": "Mojom",
      "properties": {
        "mojom.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional source roots for resolving `import \"…\";` paths. Workspace-relative or absolute. Workspace roots are always searched in addition to this list."
        },
        "mojom.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Emit diagnostics for parse errors, duplicate ordinals, unresolved imports, and unknown type references."
        },
        "mojom.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Recompute diagnostics as you type (debounced). Turn off to only recompute on save."
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cd ../../crates/mojom-analyzer && wasm-pack build --target nodejs --out-dir ../../extensions/mojom/wasm --out-name mojom_analyzer",
    "build": "tsdown",
    "clean": "rm -rf dist wasm",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "package": "pnpm run build:wasm && pnpm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "tsdown --minify"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "catalog:build",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  }
}
